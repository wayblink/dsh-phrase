{
  "name": "@wayblink/phrases-dsh",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle for canned phrases — save the lines you type often and insert them into the composer with one click",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": ["dsh-plugin", "dsh-bundle", "canned-responses", "snippets", "composer"],
  "author": "wayblink",
  "homepage": "https://github.com/wayblink/phrases-dsh#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
