{
  "name": "dsh-phrase",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for canned phrases: save the lines you type often and insert them into the composer with one click. Bilingual UI (English / 中文).",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "canned-responses",
    "snippets",
    "phrases",
    "composer"
  ],
  "author": "wayblink",
  "homepage": "https://github.com/wayblink/dsh-phrase#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayblink/dsh-phrase.git"
  },
  "bugs": {
    "url": "https://github.com/wayblink/dsh-phrase/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
